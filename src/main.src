// machin-vault — the agent-first CLI. stdout = JSON answer; stderr = structured error;
// semantic exit codes (0 ok · 80-89 input · 90-99 resource · 100-109 integration ·
// 110-119 internal). Non-interactive (restore needs --yes). `help-json` is the
// self-describing catalog an agent reads first.

func print_help_json() {
    println("{\"version\":\"1\",\"ok\":true,\"tool\":\"machin-vault\"," +
        "\"summary\":\"agent-first backup vault for files + databases; list/get/unpack/restore\"," +
        "\"telemetry\":{\"what\":\"one anonymous event per invocation: version, os/arch, verb, exit class. NEVER your backup contents, target names, paths or credentials\",\"off\":\"MACHIN_VAULT_TELEMETRY=0, DO_NOT_TRACK=1, `machin-vault telemetry --telemetry-off`, or CI (default off)\",\"inspect\":\"machin-vault telemetry prints the literal payload\",\"spec\":\"https://github.com/javimosch/cli-telemetry-spec\"}," +
        "\"commands\":[" +
        "{\"name\":\"backup\",\"args\":\"[target]\",\"desc\":\"run a backup now (all targets, or one)\"}," +
        "{\"name\":\"list\",\"args\":\"[target]\",\"desc\":\"targets and versions: name, age, size, sha, encrypted\"}," +
        "{\"name\":\"get\",\"args\":\"<target> [version] --to <dir>\",\"desc\":\"copy the raw artifact into a dir (default: latest)\"}," +
        "{\"name\":\"unpack\",\"args\":\"<target> [version] --to <dir>\",\"desc\":\"decrypt + decompress the artifact into a dir\"}," +
        "{\"name\":\"restore\",\"args\":\"<target> [version] --yes\",\"desc\":\"restore via the kind's inverse command (destructive)\"}," +
        "{\"name\":\"serve\",\"args\":\"--port N\",\"desc\":\"daemon: run the scheduler and serve the web UI\"}" +
        "]," +
        "\"flags\":[\"--config/-c <path> (default vault.json)\",\"--to <dir>\",\"--yes/-y\",\"--port/-p\"]," +
        "\"version_selector\":\"a version is the unix timestamp or the sha shown by list; omit for latest\"," +
        "\"exit_codes\":\"0 ok | 80-89 input | 90-99 resource(not found) | 100-109 integration(ssh/dump/restore) | 110-119 internal\"}")
}

func arg_at(rest, i) (s) {
    s = ""
    if i < len(rest) { s = rest[i] }
}

func main() {
    vault_dispatch()
    // After the verb finished and its result is on stdout. `serve` reports once
    // at startup instead, since it never returns here.
    a := args()
    verb := "none"
    if len(a) > 1 { verb = a[1] }
    if verb != "serve" { tel_report(verb, 0) }
}

func vault_dispatch() {
    fs := new_flags("machin-vault")
    fs = flag_str(fs, "config", "c", "vault.json", "config file path")
    fs = flag_str(fs, "to", "", "", "output directory (get/unpack)")
    fs = flag_bool(fs, "yes", "y", "confirm destructive operations (restore)")
    fs = flag_bool(fs, "telemetry-off", "", "telemetry: disable usage counts permanently")
    fs = flag_bool(fs, "telemetry-on", "", "telemetry: re-enable usage counts")
    fs = flag_int(fs, "port", "p", "8080", "serve port")
    fs = parse_flags(fs, args())
    rest := flag_args(fs)
    cmd := arg_at(rest, 0)

    if cmd == "" { print_help_json()  return }
    if cmd == "help" { print_help_json()  return }
    if cmd == "help-json" { print_help_json()  return }
    if cmd == "telemetry" {
        if flag_on(fs, "telemetry-off") {
            td, tok := tel_set(0)
            println(td)
            if tok == 0 { exit(90) }
            return
        }
        if flag_on(fs, "telemetry-on") { td, tok := tel_set(1)  println(td)  return }
        println(tel_status_json())
        return
    }

    cfg := load_config(flag_get(fs, "config"))

    if cmd == "backup" {
        only := arg_at(rest, 1)
        if only != "" {
            op_backup(cfg, find_target(cfg, only))
        } else {
            for _, t := range cfg.targets { op_backup(cfg, t) }
        }
        return
    }
    if cmd == "list" { op_list(cfg, arg_at(rest, 1))  return }
    if cmd == "get" { op_get(cfg, arg_at(rest, 1), arg_at(rest, 2), flag_get(fs, "to"))  return }
    if cmd == "unpack" { op_unpack(cfg, arg_at(rest, 1), arg_at(rest, 2), flag_get(fs, "to"))  return }
    if cmd == "restore" {
        y := 0
        if flag_on(fs, "yes") { y = 1 }
        op_restore(cfg, arg_at(rest, 1), arg_at(rest, 2), y)
        return
    }
    if cmd == "serve" { tel_report("serve", 0)  serve_app(cfg, flag_get(fs, "config"), flag_int_val(fs, "port"))  return }
    die(80, "unknown command: " + cmd + " (try help-json)")
}
