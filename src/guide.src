// guide — the full operator manual, embedded (cli-guide-spec). JSON by default, --human for text.
func guide_json() (s) { s = "{\"result\": \"success\", \"version\": \"1.0\", \"guide\": {\"machin-vault\": \"agent-first backup vault for files and databases: one binary is the CLI and the scheduler/dashboard daemon\", \"model\": {\"storage\": \"stateless: <store>/<target>/<target>_<unix>_<sha12>.<ext>[.age|.enc]; list scans the filesystem, there is no index\", \"commands\": \"each kind (file, mongo, postgres, mysql, custom) maps to a real tool (rsync, mongodump, pg_dump, mysqldump, or your shell command); machin-vault orchestrates, it never reimplements them\", \"config\": \"vault.json is read ONCE at startup by serve: restart the daemon after editing it\"}, \"loop\": [\"machin-vault help-json (commands, flags, exit codes)\", \"machin-vault -c vault.json list [target] (versions: age, size, sha, encrypted, cipher)\", \"machin-vault -c vault.json backup <target> (skipped:true when the content is unchanged)\", \"inspect without touching live data: get <target> --to dir (raw artifact) or unpack <target> --to dir (decrypt + gunzip)\", \"restore <target> [version] --yes is DESTRUCTIVE: only when the human asked for it\"], \"concepts\": {\"version\": \"a unix timestamp or the sha shown by list; omit for latest\", \"unchanged detection\": \"sha256 of the plaintext dump; equal to the newest version means skipped, no new file\", \"retention\": \"keep the newest N versions per target (retention, default 7)\", \"encryption (per target)\": \"\\\"encrypt\\\":\\\"age\\\",\\\"age_recipients\\\":[\\\"age1...\\\"] (PUBLIC keys only). The dump streams into age; no plaintext on disk; any failure leaves nothing. Files end in .age\", \"decryption\": \"unpack/restore need the age identity at call time: --identity <file> or MACHIN_VAULT_AGE_IDENTITY=<file>; with sealed: sealed exec --file MACHIN_VAULT_AGE_IDENTITY=<path> -- machin-vault unpack <t> --to <dir>\", \"secrets (per target)\": \"\\\"secrets\\\":[{\\\"env\\\":\\\"MV_PW\\\",\\\"from\\\":\\\"file:/etc/machin-vault/secrets/<name>\\\"}] (or \\\"from\\\":\\\"env:NAME\\\"). The command/restore reference \\\"$MV_PW\\\"; the value is loaded by the shell into the child's ENVIRONMENT, never written in vault.json, never in argv, never in machin-vault output (errors are redacted)\", \"legacy encrypt_password\": \"global openssl aes-256-cbc (.enc), unauthenticated; still readable, prefer per-target age\"}, \"examples\": [{\"goal\": \"mongo over ssh without a password in vault.json or in local argv\", \"do\": [\"secret file: install -m 600 /dev/null /etc/machin-vault/secrets/vps1-mongo && edit it (value only)\", \"target: \\\"secrets\\\":[{\\\"env\\\":\\\"MV_PW\\\",\\\"from\\\":\\\"file:/etc/machin-vault/secrets/vps1-mongo\\\"}], \\\"command\\\":\\\"printf '%s\\\\\\\\n' \\\\\\\"$MV_PW\\\\\\\" | ssh host 'read -r P; docker exec mongo mongodump --archive --gzip -u root --password \\\\\\\"$P\\\\\\\" --authenticationDatabase admin'\\\"\"]}, {\"goal\": \"local mysql\", \"do\": [\"kind mysql with no password field + \\\"secrets\\\":[{\\\"env\\\":\\\"MYSQL_PWD\\\",\\\"from\\\":\\\"file:/etc/machin-vault/secrets/db\\\"}] (mysqldump reads MYSQL_PWD)\"]}, {\"goal\": \"postgres\", \"do\": [\"\\\"secrets\\\":[{\\\"env\\\":\\\"PGPASSWORD\\\",\\\"from\\\":\\\"file:...\\\"}] (pg_dump reads PGPASSWORD; over ssh pass it on stdin as in the mongo example)\"]}, {\"goal\": \"encrypted target\", \"do\": [\"\\\"encrypt\\\":\\\"age\\\",\\\"age_recipients\\\":[\\\"age1primary\\\",\\\"age1breakglass\\\"]\"]}], \"gotchas\": [\"a secret used INSIDE a double-quoted ssh argument (ssh h \\\"cmd $MV_PW\\\") is expanded locally and ends up in the local ssh argv: send it on stdin (printf | ssh h 'read -r P; ...') instead\", \"even on stdin, a remote tool that takes the password as a flag shows it in the REMOTE ps; best is a dump-only command on the DB host that reads its own credentials\", \"secret files must be absolute paths with mode 0600 or 0400, else the target is refused (exit 80) before the dump; a missing or empty secret: exit 90 / 100\", \"restore uses stdin for the artifact: do not send a secret on stdin in a restore command, use a remote credentials file there\", \"encrypt is refused for kind=file (rsync cannot stream): wrap it in a custom tar command\", \"mirrors that filter by extension must include *.age\", \"telemetry: one anonymous event per run (verb, version, os/arch, exit class); never targets, paths or secrets; off with DO_NOT_TRACK=1\"], \"exit_codes\": \"0 ok | 80-89 input (bad config, missing flag) | 90-99 resource (not found, missing tool or secret) | 100-109 integration (ssh/dump/restore/decrypt failed) | 110-119 internal\", \"see_also\": [\"machin-vault help-json\"]}}" }
func guide_human() (s) { s = "machin-vault guide\n\nMODEL\n  One binary: agent-first CLI + scheduler/dashboard daemon (serve).\n  Artifacts: <store>/<target>/<target>_<unix>_<sha12>.<ext>[.age|.enc]; list scans the filesystem.\n  vault.json is read once at startup by serve: restart after editing.\n\nLOOP\n  help-json -> list [target] -> backup <target> -> get/unpack --to dir -> restore --yes (destructive, only on request)\n\nENCRYPTION (per target)\n  \"encrypt\":\"age\", \"age_recipients\":[\"age1...\"]   public keys only; no plaintext on disk; files end .age\n  decrypt: --identity <file> or MACHIN_VAULT_AGE_IDENTITY=<file>\n    e.g. sealed exec --file MACHIN_VAULT_AGE_IDENTITY=machin-vault/age-identity -- machin-vault unpack <t> --to <dir>\n\nSECRETS (per target)\n  \"secrets\":[{\"env\":\"MV_PW\",\"from\":\"file:/etc/machin-vault/secrets/<name>\"}]   (or \"from\":\"env:NAME\")\n  command/restore use \"$MV_PW\". The shell loads the value into the child's environment:\n  never in vault.json, never in argv, never in machin-vault output (errors are redacted).\n  Secret files: absolute path, mode 0600/0400, else refused before the dump.\n  mysql: env MYSQL_PWD (no password field). postgres: PGPASSWORD.\n  ssh: do NOT write ssh h \"cmd $MV_PW\" (expands into local argv). Use stdin:\n    printf '%s\\n' \"$MV_PW\" | ssh h 'read -r P; tool --password \"$P\"'\n  Best: a dump-only command on the DB host that reads its own credentials.\n\nEXIT CODES\n  0 ok | 80-89 input | 90-99 resource | 100-109 integration | 110-119 internal\n" }
